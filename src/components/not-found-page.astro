---
import type { NotFoundPage } from "sanity.types";
import Container from "@/components/ui/layout/container.astro";
import RichText from "@/components/ui/rich-text.astro";
import Heading from "@/components/ui/typography/heading.astro";
import Layout from "@/layouts/layout.astro";
import { extractSEOFromPage } from "@/sanity/lib/extract-seo";
import { loadNotFoundPage } from "@/sanity/lib/load-pages";

const { isPreview } = Astro.locals;
const notFoundPage = (await loadNotFoundPage(
  isPreview
)) as NotFoundPage | null;

// Generic fallback so the template ships with a working 404 page even
// before a notFoundPage document is created in Sanity.
const genericTitle = "404 — Page not found";
const genericMessage =
  "The page you're looking for doesn't exist or has been moved.";

if (!notFoundPage) {
  console.warn(
    "No notFoundPage document in Sanity — rendering the generic 404 page. Create one in Studio to customize it."
  );
}

const seo = notFoundPage
  ? extractSEOFromPage(notFoundPage)
  : {
      description: genericMessage,
      image: "",
      imageAlt: undefined,
      noIndex: false,
      title: genericTitle,
    };
---

<Layout
  description={seo.description}
  image={seo.image ?? ""}
  imageAlt={seo.imageAlt}
  noIndex={seo.noIndex}
  page={notFoundPage ?? {
    _createdAt: "",
    _id: "notFoundPage",
    _rev: "",
    _type: "notFoundPage",
    _updatedAt: "",
  }}
  title={seo.title}
>
  <Container as="section">
    <Heading as="h1" size="h1">{notFoundPage?.title || genericTitle}</Heading>
    {
      notFoundPage?.content ? (
        <RichText value={notFoundPage.content} />
      ) : (
        <p>{genericMessage}</p>
      )
    }
    {!notFoundPage?.content && <a href="/">Back to home</a>}
  </Container>
</Layout>
