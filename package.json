{
  "name": "",
  "version": "2.0.4",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "blueprint:deploy": "npx sanity blueprints deploy",
    "build": "npx sanity schema extract --force && npx sanity typegen generate && astro build",
    "create:component": "tsx scripts/create-component.ts",
    "create:page-type": "tsx scripts/create-page-type.ts",
    "delete:component": "tsx scripts/delete-component.ts",
    "delete:page-type": "tsx scripts/delete-page-type.ts",
    "dev": "astro dev",
    "functions:logs": "npx sanity functions logs",
    "functions:test": "npx sanity functions test",
    "lint": "npx ultracite check",
    "lint:fix": "npx ultracite fix",
    "manage:page-components": "tsx scripts/manage-page-type-components.ts",
    "prepare": "husky",
    "preview": "astro preview",
    "release": "tsx scripts/release.ts",
    "setup": "tsx scripts/setup-project.ts",
    "typecheck": "astro check",
    "typegen": "npx sanity schema extract --force && npx sanity typegen generate",
    "typegen:watch": "npx sanity schema extract --force && npx sanity typegen generate"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "npx ultracite fix"
    ]
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "undici": "^7.30.2"
    },
    "@mux/mux-player-astro": {
      "astro": "$astro"
    },
    "@oclif/core": {
      "minimatch": "^11.0.5"
    },
    "@sanity/uuid": {
      "uuid": "^11.1.1"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "^1.9.1"
    },
    "ultracite": {
      "deepmerge": "4.1.1"
    }
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^11.1.11",
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@inquirer/prompts": "^8.7.5",
    "@mux/mux-player-astro": "^3.14.1",
    "@mux/mux-video": "^0.31.6",
    "@resvg/resvg-js": "^2.6.2",
    "@sanity/astro": "^3.6.0",
    "@sanity/client": "^8.15.0",
    "@sanity/icons": "^5.2.3",
    "@sanity/ui": "^4.4.10",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.5",
    "astro-portabletext": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.2.0",
    "sanity": "^6.22.0",
    "sanity-plugin-mux-input": "^5.2.2",
    "schema-dts": "^2.1.0",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@sanity/blueprints": "^0.33.0",
    "@sanity/functions": "^1.11.0",
    "@sanity/preview-url-secret": "^4.0.4",
    "baseline-browser-mapping": "^2.11.35",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsx": "^4.23.15",
    "ultracite": "^8.1.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
