---
interface Props {
  description: string;
  image?: string;
  imageAlt?: string;
  logo?: string;
  noIndex: boolean;
  title: string;
}

const { title, description, image, imageAlt, logo, noIndex } = Astro.props;
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : null;

// Fall back to dynamic OG image if no seoImage is set
const fallbackOgImage = Astro.site
  ? new URL("/og.png", Astro.site).toString()
  : "/og.png";
const ogImage = image || fallbackOgImage;
---

<title>{title}</title>
<meta content={description} name="description" >
{noIndex && <meta content="noindex, nofollow" name="robots" />}
{canonicalUrl && <link href={canonicalUrl.toString()} rel="canonical" />}
<!-- Open Graph / Facebook -->
<meta content="website" property="og:type" >
<meta content={title} property="og:title" >
{imageAlt && <meta content={imageAlt} property="og:image:alt" />}
<meta content={description} property="og:description" >
<meta content={ogImage} property="og:image" >
{logo && <meta content={logo} property="og:logo" />}
{canonicalUrl && <meta content={canonicalUrl.toString()} property="og:url" />}
<!-- Twitter -->
<meta content="summary_large_image" name="twitter:card" >
<meta content={title} name="twitter:title" >
<meta content={description} name="twitter:description" >
<meta content={ogImage} name="twitter:image" >
{imageAlt && <meta content={imageAlt} property="twitter:image:alt" />}
