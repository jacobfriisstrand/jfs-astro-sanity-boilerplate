{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/astro"
  ],
  // Biome parser can't handle Astro's frontmatter `return` statements in [...slug].astro
  "files": {
    // sanity.types.ts is generated by `sanity typegen generate` and trips several
    // Biome rules (see sanity-io/codegen#24), so it is excluded from linting.
    // Imports of the generated types use the `sanity/types` specifier, which is
    // mapped to this file via tsconfig.json paths and attributed to the declared
    // `sanity` package by Biome's noUndeclaredDependencies rule.
    "includes": ["!sanity.types.ts", "!src/pages/\\[...slug\\].astro"]
  },
  "overrides": [
    {
      // Biome 2.6's Astro formatter corrupts inline <script> blocks (collapses
      // statements and splits arrows in ways TypeScript rejects). Keep linting
      // .astro files, but let them keep their hand-formatted structure until
      // upstream formatting is safe.
      "includes": ["**/*.astro"],
      "formatter": {
        "enabled": false
      }
    },
    {
      // `class` is the correct attribute in Astro templates; the React-oriented
      // noUnknownAttribute rule misfires on .astro files.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": "off"
          }
        }
      }
    },
    {
      // Static asset SVGs (favicon) are decorative by definition.
      "includes": ["public/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
